---
import SectionTitle from '../ui/SectionTitle.astro';
import { profile } from '../../data/profile';
---

<section id="blog" class="container" style="padding-block: var(--section-padding-y);">
  <SectionTitle id="blog" number="06">기술 블로그</SectionTitle>

  <div class="blog-list">
    {profile.blogPosts.map((post) => (
      <a
        href={post.url}
        target="_blank"
        rel="noopener noreferrer"
        class="blog-link group flex items-center justify-between"
        style="padding-block: var(--space-8); text-decoration: none; border-top: 1px solid var(--color-border);"
      >
        <span
          class="text-[var(--color-text)]"
          style="font-size: var(--font-size-xl); font-weight: var(--font-weight-medium); line-height: 1.8; word-break: keep-all;"
        >
          {post.title}
        </span>
        <span
          class="shrink-0 text-[var(--color-text-muted)]"
          style="font-size: var(--font-size-xl); margin-left: var(--space-4);"
        >
          ↗
        </span>
      </a>
    ))}
  </div>
</section>

<style>
  .blog-list {
    border-bottom: 1px solid var(--color-border);
  }

  .blog-link {
    background-color: transparent;
    transition: background-color 150ms;
  }

  .blog-link:hover {
    background-color: var(--color-surface);
  }

  .blog-link:hover span {
    color: var(--color-accent);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-link {
      transition: none;
    }
  }
</style>

---
import SectionTitle from '../ui/SectionTitle.astro';
import { profile } from '../../data/profile';
---

<section id="blog" class="container" style="padding-block: var(--section-padding-y);">
  <div data-animate><SectionTitle id="blog" number="06">기술 블로그</SectionTitle></div>

  <div>
    {profile.blogPosts.map((post, index) => (
      <a
        data-animate
        data-delay={String(index + 1)}
        href={post.url}
        target="_blank"
        rel="noopener noreferrer"
        class="blog-link"
      >
        <span class="blog-title">{post.title}</span>
        <span class="blog-arrow">↗</span>
      </a>
    ))}
  </div>
</section>

<style>
  .blog-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-border);
    text-decoration: none;
    transition: background-color 0.18s ease, padding-inline 0.18s ease;
    margin-inline: calc(-1 * var(--space-4));
    padding-inline: var(--space-4);
  }
  .blog-link:last-child {
    border-bottom: 1px solid var(--color-border);
  }
  .blog-link:hover {
    background-color: var(--color-surface);
  }
  .blog-link .blog-title {
    font-size: var(--font-size-xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    word-break: keep-all;
    transition: color 0.18s ease;
  }
  .blog-link:hover .blog-title {
    color: var(--color-accent);
  }
  .blog-link .blog-arrow {
    font-size: var(--font-size-xl);
    color: var(--color-text-muted);
    flex-shrink: 0;
    transition: transform 0.18s ease, color 0.18s ease;
  }
  .blog-link:hover .blog-arrow {
    transform: translate(4px, -4px);
    color: var(--color-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .blog-link,
    .blog-link .blog-title,
    .blog-link .blog-arrow { transition: none; }
    .blog-link:hover .blog-arrow { transform: none; }
  }
</style>

---
import { profile } from '../../data/profile';

const skillIcons: Record<string, string> = {
  'Java': 'devicon-java-plain colored',
  'Spring Boot': 'devicon-spring-plain colored',
  'GraphQL': 'devicon-graphql-plain colored',
  'Linux': 'devicon-linux-plain colored',
  'Kubernetes(k3s, k8s)': 'devicon-kubernetes-plain colored',
  'Docker': 'devicon-docker-plain colored',
  'Bash': 'devicon-bash-plain colored',
  'MySQL': 'devicon-mysql-plain colored',
  'PostgreSQL': 'devicon-postgresql-plain colored',
  'MariaDB': 'devicon-mariadb-plain colored',
  'AWS EC2': 'devicon-amazonwebservices-plain-wordmark colored',
  'Git': 'devicon-git-plain colored',
};

const allSkills = Object.entries(profile.skills).flatMap(([cat, items]) =>
  items.map((s) => ({ category: cat, skill: s }))
);
const ticker = [...allSkills, ...allSkills];
---

<section id="skills" class="skills-section">
  <div class="container">
    <h2
      class="section-title"
      data-animate
      style="font-size: var(--font-size-sm); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-12);"
    >
      Skills
    </h2>
  </div>

  <!-- 카테고리별 행 -->
  <div class="skills-categories container" data-animate data-delay="1">
    {Object.entries(profile.skills).map(([category, items]) => (
      <div class="skill-row">
        <span class="skill-cat">{category}</span>
        <div class="skill-tags">
          {items.map((skill) => {
            const iconClass = skillIcons[skill];
            return (
              <span class="skill-tag">
                {iconClass && (
                  <i class={`${iconClass} skill-icon`} aria-hidden="true" />
                )}
                {skill}
              </span>
            );
          })}
        </div>
      </div>
    ))}
  </div>

  <!-- 애니메이션 티커 -->
  <div class="ticker-wrap" aria-hidden="true">
    <div class="ticker-track">
      {ticker.map((item) => {
        const iconClass = skillIcons[item.skill];
        return (
          <span class="ticker-item">
            {iconClass && <i class={`${iconClass} ticker-icon`} />}
            <span class="ticker-skill">{item.skill}</span>
            <span class="ticker-dot">·</span>
          </span>
        );
      })}
    </div>
  </div>
</section>

<style>
  .skills-section {
    padding-block: var(--section-padding-y);
    border-bottom: 1px solid var(--color-border);
    overflow: hidden;
  }

  .skills-categories {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-bottom: var(--space-12);
  }

  .skill-row {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  @media (min-width: 640px) {
    .skill-row {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-6);
    }
  }

  .skill-cat {
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
    min-width: 6rem;
    flex-shrink: 0;
    padding-top: 0.35rem;
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .skill-tag {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: var(--color-text-muted);
    transition: border-color 0.18s ease, color 0.18s ease, background-color 0.18s ease;
    cursor: default;
  }

  .skill-tag:hover {
    border-color: var(--color-accent);
    color: var(--color-accent);
    background-color: var(--color-surface);
  }

  .skill-icon {
    font-size: 1.1rem;
    line-height: 1;
    flex-shrink: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .skill-tag { transition: none; }
  }

  /* ─── Ticker ─── */
  .ticker-wrap {
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
    padding-block: var(--space-4);
    overflow: hidden;
  }

  .ticker-track {
    display: flex;
    white-space: nowrap;
    animation: ticker 30s linear infinite;
  }

  @keyframes ticker {
    0%   { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track { animation: none; }
  }

  .ticker-item {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding-inline: var(--space-4);
    font-size: var(--font-size-sm);
  }

  .ticker-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .ticker-skill {
    color: var(--color-text);
    font-weight: var(--font-weight-medium);
  }

  .ticker-dot {
    color: var(--color-accent);
    margin-left: var(--space-2);
  }
</style>

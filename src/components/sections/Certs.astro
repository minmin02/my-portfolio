---
import SectionTitle from '../ui/SectionTitle.astro';
import { profile } from '../../data/profile';

const certs = profile.certifications.filter((c) => !c.includes('TODO'));
const awards = profile.awards.filter((a) => !a.includes('TODO'));
const eduPrograms = profile.educationPrograms.filter((e) => !e.includes('TODO'));

const allItems = [
  ...certs.map((text) => ({ label: 'CERT', text })),
  ...awards.map((text) => ({ label: 'AWARD', text })),
  ...eduPrograms.map((text) => ({ label: 'EDUCATION', text })),
];
---

<section id="certs" class="container" style="padding-block: var(--section-padding-y);">
  <div data-animate><SectionTitle id="certs" number="05">자격증 · 수상 · 교육</SectionTitle></div>

  <div>
    {allItems.map((item, index) => (
      <div
        data-animate
        data-delay={String(index + 1)}
        class="row-hover flex flex-col md:flex-row"
        style="border-top: 1px solid var(--color-border); padding-block: var(--space-5); gap: var(--space-4);"
      >
        <p
          class="shrink-0 text-[var(--color-text-muted)]"
          style="font-size: var(--font-size-xs); letter-spacing: 0.1em; min-width: 8rem; padding-top: var(--space-1);"
        >
          {item.label}
        </p>
        <p
          class="text-[var(--color-text)]"
          style="font-size: var(--font-size-base); line-height: 1.8; word-break: keep-all;"
        >
          {item.text}
        </p>
      </div>
    ))}
  </div>
</section>

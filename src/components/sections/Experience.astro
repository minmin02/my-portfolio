---
import { profile } from '../../data/profile';
---

<section id="experience" class="container">
  <h2
    class="section-title"
    data-animate
    style="font-size: var(--font-size-sm); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-12);"
  >
    Experience
  </h2>

  <div class="grid" style="gap: var(--space-12);">
    {profile.experience.map((exp, index) => {
      const subInfo = [exp.team, exp.role, exp.type].filter(Boolean).join(' · ');
      return (
        <div
          data-animate="fade-left"
          data-delay={String(index + 1)}
          class="exp-item"
        >
          <div class="grid" style="gap: var(--space-4);">
            <div class="flex flex-col gap-[var(--space-2)] sm:flex-row sm:items-baseline sm:justify-between">
              <div class="flex flex-col" style="gap: var(--space-1);">
                <span
                  class="text-[var(--color-text)]"
                  style="font-size: var(--font-size-2xl); font-weight: var(--font-weight-bold); word-break: keep-all; line-height: 1.4;"
                >
                  {exp.company}
                </span>
                {subInfo && (
                  <span
                    class="text-[var(--color-text-muted)]"
                    style="font-size: var(--font-size-sm); line-height: 1.8;"
                  >
                    {subInfo}
                  </span>
                )}
              </div>
              <span
                class="text-[var(--color-text-muted)] shrink-0"
                style="font-size: var(--font-size-sm);"
              >
                {exp.period}
              </span>
            </div>

            {exp.bullets.length > 0 && (
              <ul class="grid" style="gap: var(--space-3); list-style: none; padding-left: 0;">
                {exp.bullets.map((bullet) => (
                  <li
                    class="text-[var(--color-text)] flex gap-[var(--space-3)]"
                    style="font-size: var(--font-size-base); line-height: 1.8; word-break: keep-all;"
                  >
                    <span class="text-[var(--color-accent)] shrink-0" aria-hidden="true">—</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>
        </div>
      );
    })}
  </div>
</section>

<style>
  .exp-item {
    border-left: 3px solid var(--color-accent);
    padding-left: var(--space-6);
    transition: border-left-width 0.2s ease, padding-left 0.2s ease;
  }
  .exp-item:hover {
    border-left-width: 5px;
    padding-left: calc(var(--space-6) - 2px);
  }
  @media (prefers-reduced-motion: reduce) {
    .exp-item { transition: none; }
  }
</style>

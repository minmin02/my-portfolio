---
import { profile } from '../../data/profile';
import SectionTitle from '../ui/SectionTitle.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="experience" class="section-alt">
  <div class="container">
    <SectionTitle num="02">Experience</SectionTitle>

    <div class="exp-timeline">
      {profile.experience.map((exp, index) => {
        const logoSrc = exp.logo ? `${base}/photo/${exp.logo}` : null;
        const subInfo = [exp.team, exp.role, exp.type].filter(Boolean).join(' · ');
        return (
          <div
            class="exp-item"
            data-animate="fade-left"
            data-delay={String(index + 1)}
          >
            <!-- 타임라인 인디케이터: 점 + 선 -->
            <div class="exp-indicator">
              <span class="exp-dot"></span>
            </div>

            <!-- 본문 -->
            <div class="exp-body">
              <div class="exp-header">
                <div class="exp-titles">
                  <span class="exp-company">{exp.company}</span>
                  <span class="exp-period">{exp.period}</span>
                </div>
                {logoSrc && (
                  <div class="exp-logo-wrap">
                    <img
                      src={logoSrc}
                      alt={`${exp.company} 로고`}
                      class="exp-logo"
                      loading="lazy"
                    />
                  </div>
                )}
              </div>

              {subInfo && <p class="exp-sub">{subInfo}</p>}

              {exp.bullets.length > 0 && (
                <ul class="exp-bullets">
                  {exp.bullets.map((bullet) => (
                    <li>
                      <span class="bullet-dash" aria-hidden="true">—</span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  /* ── 타임라인 컨테이너 ── */
  .exp-timeline {
    display: flex;
    flex-direction: column;
  }

  /* ── 각 항목 행 ── */
  .exp-item {
    display: flex;
    gap: var(--space-6);
    padding-bottom: var(--space-10);
    align-items: stretch;
  }

  /* ── 인디케이터 열 (점 + 세로선) ── */
  .exp-indicator {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: var(--space-6);
    padding-top: var(--space-1);
  }

  .exp-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-accent);
    border: 2px solid var(--color-bg);
    flex-shrink: 0;
    position: relative;
    z-index: 1;
  }

  /* 마지막 항목을 제외한 세로선 */
  .exp-item:not(:last-child) .exp-indicator::after {
    content: '';
    flex: 1;
    width: 1px;
    background: var(--color-border);
    margin-top: var(--space-2);
  }

  /* ── 본문 ── */
  .exp-body {
    flex: 1;
    min-width: 0;
    padding-bottom: var(--space-2);
  }

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
    margin-bottom: var(--space-2);
  }

  .exp-titles {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
  }

  .exp-company {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    word-break: keep-all;
    line-height: 1.3;
  }

  .exp-period {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .exp-sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    line-height: 1.8;
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .exp-bullets li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.8;
    word-break: keep-all;
  }

  .bullet-dash {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── 로고 ── */
  .exp-logo-wrap {
    width: 160px;
    height: 80px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-2);
  }

  .exp-logo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  /* 모바일: 로고 숨김 */
  @media (max-width: 639px) {
    .exp-logo-wrap {
      display: none;
    }
  }
</style>

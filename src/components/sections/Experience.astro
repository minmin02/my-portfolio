---
import { profile } from '../../data/profile';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section id="experience" class="container">
  <h2
    class="section-title"
    data-animate
    style="font-size: var(--font-size-sm); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-12);"
  >
    Experience
  </h2>

  <div class="exp-list">
    {profile.experience.map((exp, index) => {
      const logoSrc = exp.logo ? `${base}/photo/${exp.logo}` : null;
      const subInfo = [exp.team, exp.role, exp.type].filter(Boolean).join(' · ');
      const reversed = index % 2 === 1;
      return (
        <div
          class={`exp-row${reversed ? ' reversed' : ''}`}
          data-animate="fade-left"
          data-delay={String(index + 1)}
        >
          <!-- 텍스트 영역 -->
          <div class="exp-content">
            <div class="exp-header">
              <span class="exp-company">{exp.company}</span>
              <span class="exp-period">{exp.period}</span>
            </div>
            {subInfo && <p class="exp-sub">{subInfo}</p>}
            {exp.bullets.length > 0 && (
              <ul class="exp-bullets">
                {exp.bullets.map((bullet) => (
                  <li>
                    <span class="bullet-dash" aria-hidden="true">—</span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </div>

          <!-- 로고 영역 -->
          {logoSrc && (
            <div class="exp-logo-wrap">
              <img
                src={logoSrc}
                alt={`${exp.company} 로고`}
                class="exp-logo"
                loading="lazy"
              />
            </div>
          )}
        </div>
      );
    })}
  </div>
</section>

<style>
  .exp-list {
    display: flex;
    flex-direction: column;
  }

  /* ── 각 항목: 기본 텍스트 왼쪽 · 로고 오른쪽 ── */
  .exp-row {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-10);
    padding-block: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  /* 홀수 항목: 로고 왼쪽 · 텍스트 오른쪽 */
  .exp-row.reversed {
    grid-template-columns: auto 1fr;
  }

  .exp-row.reversed .exp-content {
    order: 2;
  }

  .exp-row.reversed .exp-logo-wrap {
    order: 1;
  }

  /* 모바일: 세로 스택, 로고 위 */
  @media (max-width: 639px) {
    .exp-row,
    .exp-row.reversed {
      grid-template-columns: 1fr;
    }

    .exp-row.reversed .exp-content,
    .exp-row.reversed .exp-logo-wrap {
      order: unset;
    }

    .exp-logo-wrap {
      justify-self: start;
    }
  }

  /* ── 텍스트 ── */
  .exp-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-bottom: var(--space-2);
  }

  .exp-company {
    font-size: var(--font-size-2xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    word-break: keep-all;
    line-height: 1.3;
  }

  .exp-period {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  .exp-sub {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    margin-bottom: var(--space-4);
    line-height: 1.8;
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .exp-bullets li {
    display: flex;
    gap: var(--space-3);
    font-size: var(--font-size-base);
    color: var(--color-text);
    line-height: 1.8;
    word-break: keep-all;
  }

  .bullet-dash {
    color: var(--color-accent);
    flex-shrink: 0;
  }

  /* ── 로고 ── */
  .exp-logo-wrap {
    width: 160px;
    height: 80px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: var(--space-3);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
  }

  .exp-logo {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  [data-theme="dark"] .exp-logo-wrap {
    background: var(--color-surface-2);
  }
</style>

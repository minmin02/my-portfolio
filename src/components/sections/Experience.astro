---
import SectionTitle from '../ui/SectionTitle.astro';
import Card from '../ui/Card.astro';
import { profile } from '../../data/profile';
---

<section id="experience" class="container" style="padding-block: var(--section-padding-y);">
  <SectionTitle id="experience" number="02">경력</SectionTitle>

  <div class="grid gap-[var(--space-8)]">
    {profile.experience.map((exp) => (
      <Card>
        <div class="grid gap-[var(--space-6)]">
          <div class="flex flex-col gap-[var(--space-1)] sm:flex-row sm:items-baseline sm:justify-between">
            <div class="flex flex-col gap-[var(--space-1)]">
              <span
                class="text-[var(--color-text)] font-[var(--font-weight-medium)]"
                style="font-size: var(--font-size-lg);"
              >
                {exp.company}
              </span>
              <span class="text-[var(--color-text-muted)]" style="font-size: var(--font-size-sm);">
                {exp.team} · {exp.role} · {exp.type}
              </span>
            </div>
            <span
              class="text-[var(--color-text-muted)] shrink-0"
              style="font-size: var(--font-size-sm);"
            >
              {exp.period}
            </span>
          </div>

          <ul class="grid gap-[var(--space-3)]" style="padding-left: var(--space-5); list-style: disc;">
            {exp.bullets.map((bullet) => (
              <li
                class="text-[var(--color-text)]"
                style="font-size: var(--font-size-base); line-height: 1.8; word-break: keep-all;"
              >
                {bullet}
              </li>
            ))}
          </ul>
        </div>
      </Card>
    ))}
  </div>
</section>

---
import { getCollection } from 'astro:content';
import SectionTitle from '../ui/SectionTitle.astro';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import Button from '../ui/Button.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="container" style="padding-block: var(--section-padding-y);">
  <SectionTitle id="projects" number="03">프로젝트</SectionTitle>

  <div class="grid gap-[var(--space-6)] sm:grid-cols-2">
    {projects.map((project) => (
      <a
        href={`${import.meta.env.BASE_URL}/projects/${project.id}`}
        style="text-decoration: none; display: block;"
      >
        <Card class="h-full hover:border-[var(--color-text-muted)] transition-colors duration-150">
          <div class="grid gap-[var(--space-4)] h-full">
            <div class="grid gap-[var(--space-2)]">
              <div class="flex items-start justify-between gap-[var(--space-2)]">
                <h3
                  class="text-[var(--color-text)] font-[var(--font-weight-medium)]"
                  style="font-size: var(--font-size-base); word-break: keep-all;"
                >
                  {project.data.title}
                </h3>
                {project.data.award && (
                  <span
                    class="text-[var(--color-accent)] shrink-0"
                    style="font-size: var(--font-size-xs);"
                  >
                    🏆
                  </span>
                )}
              </div>
              <p
                class="text-[var(--color-text-muted)]"
                style="font-size: var(--font-size-xs); letter-spacing: 0.06em;"
              >
                {project.data.period} · {project.data.org}
              </p>
            </div>

            <p
              class="text-[var(--color-text-muted)] flex-1"
              style="font-size: var(--font-size-sm); line-height: 1.7; word-break: keep-all;"
            >
              {project.data.summary}
            </p>

            <div class="flex flex-wrap gap-[var(--space-1)]">
              {project.data.stack.map((s) => (
                <Tag>{s}</Tag>
              ))}
            </div>
          </div>
        </Card>
      </a>
    ))}
  </div>
</section>

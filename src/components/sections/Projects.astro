---
import { getCollection } from 'astro:content';
import SectionTitle from '../ui/SectionTitle.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section id="project" class="section-alt">
  <div class="container">
    <SectionTitle num="04">Project</SectionTitle>

    <div class="project-grid">
      {projects.map((project, index) => {
        const base = import.meta.env.BASE_URL.replace(/\/$/, '');
        const imgSrc = project.data.image
          ? `${base}/photo/${project.data.image}.png`
          : null;
        const notionUrl = project.data.notion ?? '#';
        const visibleStack = project.data.stack.slice(0, 3);
        const extraStack = project.data.stack.length - 3;
        return (
          <a
            href={notionUrl}
            target={notionUrl !== '#' ? '_blank' : undefined}
            rel={notionUrl !== '#' ? 'noopener noreferrer' : undefined}
            class="project-card card-lift"
            data-animate
            data-delay={String(index + 1)}
          >
            <!-- 이미지 (blur backdrop) -->
            <div
              class="project-img-wrap"
              style={imgSrc ? `--blur-src: url('${imgSrc}')` : ''}
            >
              {imgSrc ? (
                <img
                  src={imgSrc}
                  alt={project.data.title}
                  class="project-img"
                  loading="lazy"
                />
              ) : (
                <div class="project-img-placeholder" aria-hidden="true" />
              )}
              {notionUrl !== '#' && (
                <div class="project-img-overlay" aria-hidden="true">
                  <span class="overlay-cta">자세히 보기 ↗</span>
                </div>
              )}
            </div>

            <!-- 카드 정보 -->
            <div class="project-info">
              <!-- 제목 + 수상 뱃지 -->
              <div class="project-meta">
                <h3 class="project-title">{project.data.title}</h3>
                {project.data.award && (
                  <span class="project-award">{project.data.award}</span>
                )}
              </div>

              <!-- 요약 설명 (2줄 클램프) -->
              <p class="project-summary">{project.data.summary}</p>

              <!-- 스택 pill 태그 -->
              <div class="project-stack">
                {visibleStack.map((tag) => (
                  <span class="stack-tag">{tag}</span>
                ))}
                {extraStack > 0 && (
                  <span class="stack-tag stack-tag-more">+{extraStack}</span>
                )}
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  /* ── 카드 ── */
  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    background: var(--color-bg);
  }

  .project-card:hover {
    text-decoration: none;
  }

  /* 블러 배경 + contain 이미지 */
  .project-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  .project-img-wrap::before {
    content: '';
    position: absolute;
    inset: -12%;
    background-image: var(--blur-src);
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(0.55) saturate(1.2);
  }

  .project-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-img { transition: none; }
    .project-card:hover .project-img { transform: none; }
  }

  .project-img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-surface-2);
  }

  .project-img-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    background: color-mix(in srgb, var(--color-bg) 55%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .project-card:hover .project-img-overlay {
    opacity: 1;
  }

  .overlay-cta {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
    letter-spacing: 0.04em;
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-img-overlay { transition: none; }
  }

  /* ── 카드 정보 영역 ── */
  .project-info {
    padding: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    flex: 1;
  }

  .project-meta {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    flex-wrap: wrap;
  }

  .project-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    word-break: keep-all;
    line-height: 1.4;
  }

  .project-award {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-accent);
    border: 1px solid var(--color-accent);
    border-radius: var(--radius-md);
    padding: 0.05em 0.55em;
    white-space: nowrap;
  }

  .project-summary {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    line-height: 1.7;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    word-break: keep-all;
  }

  .project-stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin-top: auto;
  }

  .stack-tag {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 0.15em 0.6em;
  }

  .stack-tag-more {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }
</style>

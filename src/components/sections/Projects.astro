---
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section id="project" class="container">
  <h2
    class="section-title"
    data-animate
    style="font-size: var(--font-size-sm); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-12);"
  >
    Project
  </h2>

  <div class="project-grid">
    {projects.map((project, index) => {
      const base = import.meta.env.BASE_URL.replace(/\/$/, '');
      const imgSrc = project.data.image
        ? `${base}/photo/${project.data.image}.png`
        : null;
      const notionUrl = project.data.notion ?? '#';
      return (
        <a
          href={notionUrl}
          target={notionUrl !== '#' ? '_blank' : undefined}
          rel={notionUrl !== '#' ? 'noopener noreferrer' : undefined}
          class="project-card card-lift"
          data-animate
          data-delay={String(index + 1)}
        >
          <div
            class="project-img-wrap"
            style={imgSrc ? `--blur-src: url('${imgSrc}')` : ''}
          >
            {imgSrc ? (
              <img
                src={imgSrc}
                alt={project.data.title}
                class="project-img"
                loading="lazy"
              />
            ) : (
              <div class="project-img-placeholder" aria-hidden="true" />
            )}
          </div>
          <div class="project-info">
            <h3 class="project-title">{project.data.title}</h3>
            <p class="project-role">{project.data.role}</p>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .project-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
  }

  @media (min-width: 640px) {
    .project-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .project-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .project-card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    text-decoration: none;
    background: var(--color-surface);
  }

  .project-card:hover {
    text-decoration: none;
  }

  /* 블러 배경 + contain 이미지 컨테이너 */
  .project-img-wrap {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--color-surface-2);
  }

  /* 블러 배경 레이어 */
  .project-img-wrap::before {
    content: '';
    position: absolute;
    inset: -12%;
    background-image: var(--blur-src);
    background-size: cover;
    background-position: center;
    filter: blur(18px) brightness(0.55) saturate(1.2);
  }

  /* 원본 이미지 (contain, 비율 유지) */
  .project-img {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
    transition: transform 0.4s ease;
  }

  .project-card:hover .project-img {
    transform: scale(1.04);
  }

  @media (prefers-reduced-motion: reduce) {
    .project-img {
      transition: none;
    }
    .project-card:hover .project-img {
      transform: none;
    }
  }

  .project-img-placeholder {
    width: 100%;
    height: 100%;
    background: var(--color-surface-2);
  }

  .project-info {
    padding: var(--space-4) var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
  }

  .project-title {
    font-size: var(--font-size-lg);
    font-weight: var(--font-weight-bold);
    color: var(--color-text);
    word-break: keep-all;
    line-height: 1.4;
  }

  .project-role {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    word-break: keep-all;
    line-height: 1.6;
  }
</style>

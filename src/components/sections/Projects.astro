---
import { getCollection } from 'astro:content';
import SectionTitle from '../ui/SectionTitle.astro';
import Tag from '../ui/Tag.astro';

const allProjects = await getCollection('projects');
const projects = allProjects.sort((a, b) => a.data.order - b.data.order);
---

<section id="projects" class="container" style="padding-block: var(--section-padding-y);">
  <div data-animate="fade"><SectionTitle id="projects" number="03">프로젝트</SectionTitle></div>

  <div>
    {projects.map((project, index) => (
      <a
        data-animate
        data-delay={String(index + 1)}
        href={`${import.meta.env.BASE_URL}/projects/${project.id}`}
        class="project-row group flex flex-col md:flex-row md:items-baseline"
        style="border-top: 1px solid var(--color-border); padding-block: var(--space-8); gap: var(--space-6);"
      >
        {/* 번호 레이블 */}
        <span
          class="text-[var(--color-text-muted)] shrink-0"
          style="font-size: var(--font-size-sm); width: 3rem; line-height: 1.8;"
        >
          {String(project.data.order).padStart(2, '0')}
        </span>

        {/* 중앙: 제목 + 설명 + 태그 */}
        <div class="flex-1 grid" style="gap: var(--space-4);">
          <h3
            class="text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors duration-150"
            style="font-size: var(--font-size-xl); font-weight: var(--font-weight-bold); word-break: keep-all; line-height: 1.8;"
          >
            {project.data.title}
          </h3>
          <p
            class="text-[var(--color-text-muted)]"
            style="font-size: var(--font-size-sm); line-height: 1.8; word-break: keep-all;"
          >
            {project.data.summary}
          </p>
          <div class="flex flex-wrap" style="gap: var(--space-1);">
            {project.data.stack.map((s) => (
              <Tag>{s}</Tag>
            ))}
          </div>
        </div>

        {/* 오른쪽: 기간·조직 + award */}
        <div
          class="flex flex-row md:flex-col md:items-end shrink-0"
          style="gap: var(--space-2);"
        >
          <p
            class="text-[var(--color-text-muted)]"
            style="font-size: var(--font-size-xs); letter-spacing: 0.06em; line-height: 1.8;"
          >
            {project.data.period}
          </p>
          <p
            class="text-[var(--color-text-muted)]"
            style="font-size: var(--font-size-xs); letter-spacing: 0.06em; line-height: 1.8;"
          >
            {project.data.org}
          </p>
          {project.data.award && (
            <span
              class="text-[var(--color-accent)]"
              style="font-size: var(--font-size-xs);"
            >
              🏆 {project.data.award}
            </span>
          )}
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .project-row {
    text-decoration: none;
    display: flex;
    transition: background-color 0.18s ease, padding-left 0.18s ease;
  }
  .project-row:hover {
    background-color: var(--color-surface);
    padding-left: var(--space-4);
  }
  @media (prefers-reduced-motion: reduce) {
    .project-row { transition: none; }
    .project-row:hover { padding-left: 0; }
  }
</style>

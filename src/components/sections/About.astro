---
import { profile } from '../../data/profile';
---

<section id="about" class="container">
  <h2
    class="section-title"
    data-animate
    style="font-size: var(--font-size-sm); letter-spacing: 0.12em; text-transform: uppercase; color: var(--color-text-muted); margin-bottom: var(--space-12);"
  >
    About Me
  </h2>

  <div class="about-grid">
    <!-- 왼쪽: 큰 이름 + 소개 텍스트 -->
    <div class="about-left">
      <h3
        class="about-name gradient-text"
        data-animate="fade-left"
        data-delay="1"
      >
        {profile.nameEn}
      </h3>

      <div class="about-lines" data-animate="fade-left" data-delay="2">
        {profile.aboutLines.map((line) => (
          <p class="about-line">{line}</p>
        ))}
      </div>
    </div>

    <!-- 오른쪽: 연락처 -->
    <div class="about-right" data-animate data-delay="3">
      <p
        class="text-[var(--color-text-muted)]"
        style="font-size: var(--font-size-xs); letter-spacing: 0.1em; margin-bottom: var(--space-4);"
      >
        CONTACT
      </p>
      <div class="flex flex-col" style="gap: var(--space-2);">
        <a
          href={profile.contact.github}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link underline-slide"
        >
          GitHub ↗
        </a>
        <a
          href={profile.contact.velog}
          target="_blank"
          rel="noopener noreferrer"
          class="contact-link underline-slide"
        >
          Velog ↗
        </a>
        <a
          href={`mailto:${profile.contact.email}`}
          class="contact-link underline-slide"
        >
          {profile.contact.email}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    gap: var(--space-12);
  }

  @media (min-width: 768px) {
    .about-grid {
      grid-template-columns: 3fr 1fr;
      gap: var(--space-16);
      align-items: start;
    }
  }

  .about-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .about-name {
    font-size: clamp(2.5rem, 6vw, 5rem);
    font-weight: var(--font-weight-bold);
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .about-lines {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .about-line {
    font-size: var(--font-size-lg);
    line-height: 1.8;
    color: var(--color-text-muted);
    word-break: keep-all;
  }

  .about-right {
    padding-top: var(--space-2);
  }

  .contact-link {
    display: inline-block;
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.15s ease;
  }

  .contact-link:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-link {
      transition: none;
    }
  }
</style>

---
import Button from '../ui/Button.astro';
import { profile } from '../../data/profile';
---

<section
  id="hero"
  class="min-h-screen flex flex-col justify-center container"
  style="position: relative; padding-block: var(--space-20); border-bottom: none;"
>
  <div class="grid gap-[var(--space-16)] max-w-4xl">
    <div class="hero-animate-1">
      <p
        class="mb-[var(--space-3)] text-[var(--font-size-sm)] text-[var(--color-text-muted)]"
        style="letter-spacing: 0.08em;"
      >
        {profile.tagline}
      </p>
      <h1
        class="font-[var(--font-weight-bold)] text-[var(--color-text)] leading-none"
        style="font-size: clamp(3.5rem, 8vw, 6rem); letter-spacing: -0.03em;"
      >
        {profile.name}
      </h1>
    </div>

    <hr class="hero-animate-2" />

    <div class="hero-animate-3 flex flex-col gap-[var(--space-8)] sm:flex-row sm:items-end sm:justify-between">
      <p
        class="text-[var(--color-text-muted)] max-w-md"
        style="font-size: var(--font-size-lg); line-height: 1.8;"
      >
        {profile.description}
      </p>

      <div class="flex flex-col gap-[var(--space-2)] items-start sm:items-end shrink-0">
        <Button href={profile.contact.github} target="_blank" variant="ghost" size="sm">
          GitHub ↗
        </Button>
        <Button href={profile.contact.velog} target="_blank" variant="ghost" size="sm">
          Velog ↗
        </Button>
        <Button href={`mailto:${profile.contact.email}`} variant="ghost" size="sm">
          {profile.contact.email}
        </Button>
      </div>
    </div>
  </div>

  <div class="scroll-indicator hero-animate-4" aria-hidden="true">
    <span class="scroll-arrow">↓</span>
    <span class="scroll-label">scroll</span>
  </div>
</section>

<style>
  .scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-arrow {
    font-size: var(--font-size-lg);
    line-height: 1;
  }

  .scroll-label {
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator {
      animation: none;
    }
  }
</style>

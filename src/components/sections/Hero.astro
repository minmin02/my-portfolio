---
import Button from '../ui/Button.astro';
import { profile } from '../../data/profile';
---

<section
  id="hero"
  class="min-h-screen flex flex-col justify-center container"
  style="position: relative; padding-block: var(--space-20); border-bottom: none;"
>
  <div class="hero-grid">
    <!-- 텍스트 영역 -->
    <div class="hero-text-col">
      <div class="hero-animate-1">
        <p
          class="mb-[var(--space-3)] text-[var(--color-text-muted)]"
          style="letter-spacing: 0.08em; font-size: var(--font-size-sm);"
        >
          {profile.tagline}
        </p>
        <h1
          class="gradient-text font-[var(--font-weight-bold)] leading-none"
          style="font-size: clamp(2.2rem, 6vw, 5rem); letter-spacing: -0.03em;"
        >
          MINKYU'S<br />PORTFOLIO
        </h1>
      </div>

      <hr class="gradient-hr hero-animate-2" style="margin-block: var(--space-10);" />

      <div class="hero-animate-3 flex flex-col gap-[var(--space-8)]">
        <div class="hero-desc">
          {profile.heroLines.map((line) => (
            <p>{line}</p>
          ))}
        </div>

        <div class="flex flex-col gap-[var(--space-2)] items-start">
          <Button href={profile.contact.github} target="_blank" variant="ghost" size="sm">
            GitHub ↗
          </Button>
          <Button href={profile.contact.velog} target="_blank" variant="ghost" size="sm">
            Velog ↗
          </Button>
          <Button href={`mailto:${profile.contact.email}`} variant="ghost" size="sm">
            {profile.contact.email}
          </Button>
        </div>
      </div>
    </div>

    <!-- 프로필 사진 -->
    <div class="hero-photo-col hero-animate-1">
      <div class="hero-photo-wrap">
        <img
          src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/photo/profile.jpeg`}
          alt="김민규 프로필 사진"
          class="hero-photo"
        />
      </div>
    </div>
  </div>

  <div class="scroll-indicator hero-animate-4" aria-hidden="true">
    <span class="scroll-arrow">↓</span>
    <span class="scroll-label">scroll</span>
  </div>
</section>

<style>
  .hero-grid {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--space-12);
    align-items: flex-start;
  }

  @media (min-width: 768px) {
    .hero-grid {
      flex-direction: row;
      align-items: center;
      gap: var(--space-16);
    }
  }

  .hero-text-col {
    flex: 1;
    min-width: 0;
  }

  .hero-photo-col {
    flex-shrink: 0;
    display: flex;
    justify-content: center;
  }

  .hero-photo-wrap {
    width: 200px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 2px solid var(--color-border);
    box-shadow: var(--shadow-md);
  }

  @media (min-width: 768px) {
    .hero-photo-wrap {
      width: 240px;
    }
  }

  .hero-photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .hero-desc {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    max-width: 28rem;
    color: var(--color-text-muted);
    font-size: var(--font-size-lg);
    line-height: 1.8;
    word-break: keep-all;
  }

  .scroll-indicator {
    position: absolute;
    bottom: var(--space-8);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-1);
    color: var(--color-text-muted);
    animation: bounce 2s ease-in-out infinite;
  }

  .scroll-arrow {
    font-size: var(--font-size-lg);
    line-height: 1;
  }

  .scroll-label {
    font-size: var(--font-size-xs);
    letter-spacing: 0.1em;
    text-transform: lowercase;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(0.5rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .scroll-indicator {
      animation: none;
    }
  }
</style>
